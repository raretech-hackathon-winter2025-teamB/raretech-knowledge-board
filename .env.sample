# ======= ✅ チームで共通にする設定 =======
MYSQL_DATABASE=hackathon_db           # 開発環境で使うデータベース名（チームで共通・固定）
MYSQL_USER=dev_user                   # 開発用のデータベースユーザ名（チーム共通）
DJANGO_TIME_ZONE=Asia/Tokyo           # タイムゾーン設定(全員共通)
DJANGO_LANGUAGE_CODE=ja               # 言語コード設定(全員共通)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1  # 許可するホスト

# ======= 🔧 各自で変更する設定 =======
MYSQL_PASSWORD=your_own_password      # 各自がローカル環境で設定するDBユーザーパスワード
MYSQL_ROOT_PASSWORD=your_root_pw      # MySQLのrootパスワード
DJANGO_SECRET_KEY=your_secret_key     # Djangoのセキュリティキー（必ず各自で生成すること）
DJANGO_DEBUG=True                     # デバッグモード設定。開発中はTrue

# ======= ☁️ S3を使う場合のみ設定 =======
USE_S3=False                          # TrueでS3保存に切り替え
AWS_ACCESS_KEY_ID=                    # IAMアクセスキー
AWS_SECRET_ACCESS_KEY=                # IAMシークレットキー
AWS_STORAGE_BUCKET_NAME=              # S3バケット名
AWS_S3_REGION_NAME=ap-northeast-1     # バケットリージョン
AWS_MEDIA_LOCATION=uploads            # バケット内プレフィックス
AWS_S3_CUSTOM_DOMAIN=                 # CloudFront等を使う場合のみ設定
